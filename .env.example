# Copier en .env et compléter. Le fichier .env n'est jamais versionné.

# --- Base de données -------------------------------------------------------
# Correspond au service `db` de docker-compose.yml
DATABASE_URL="postgresql://onsort:onsort@localhost:5433/onsort?schema=public"

# --- Application -----------------------------------------------------------
PORT=3000
APP_URL="http://localhost:5173"

# development | test | production
NODE_ENV=development

# --- Better Auth -----------------------------------------------------------
# Générer une valeur avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Connexion par Google --------------------------------------------------
# Les deux vont ensemble : une moitié seule fait échouer le démarrage. Vides, le bouton
# n'apparaît pas et le lien magique reste le seul chemin.
#
# Console Google Cloud → identifiants OAuth 2.0 « application Web ». URL de redirection
# autorisée : <BETTER_AUTH_URL>/api/auth/callback/google — donc
# http://localhost:3000/api/auth/callback/google en développement. Google refuse une
# adresse IP en production : il y faut un domaine et HTTPS.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Resend ----------------------------------------------------------------
# Clé vide : les liens magiques sont écrits en console. C'est le mode de développement, et
# il accepte n'importe quelle adresse. La clé est de toute façon ignorée sous NODE_ENV=test.
#
# Avec une clé mais sans domaine vérifié chez Resend, l'envoi n'aboutit que vers l'adresse
# du titulaire du compte. Vérifier un domaine est ce qui débloque le reste.
RESEND_API_KEY=""
MAIL_FROM="On Sort ? <no-reply@example.test>"
# --- Carte -----------------------------------------------------------------
# Vide ou absent : les tuiles OpenStreetMap sont utilisées, sans clé ni compte. Leur
# politique d'usage l'autorise sous conditions — attribution visible, Referer envoyé, cache
# respecté, aucun pré-chargement — et le code les tient.
# À renseigner seulement pour basculer vers un fournisseur (MapTiler, Stadia Maps).
MAP_TILES_URL=""
MAP_TILES_ATTRIBUTION=""

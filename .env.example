# Copier en .env et compléter. Le fichier .env n'est jamais versionné.

# --- Base de données -------------------------------------------------------
# Correspond au service `db` de docker-compose.yml
DATABASE_URL="postgresql://onsort:onsort@localhost:5433/onsort?schema=public"

# --- Application -----------------------------------------------------------
PORT=3000
APP_URL="http://localhost:5173"

# development | test | production
NODE_ENV=development

# --- Better Auth -----------------------------------------------------------
# Générer une valeur avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Resend ----------------------------------------------------------------
# Laisser vide en développement : les liens magiques sont alors écrits en console
RESEND_API_KEY=""
MAIL_FROM="On Sort ? <no-reply@example.test>"

# --- Proton ----------------------------------------------------------------
# Laisser vide en développement : les liens magiques sont alors écrits en console
PROTON_EMAIL=""
PROTON_PASSWORD=""
# --- Carte -----------------------------------------------------------------
# Vide ou absent : les tuiles OpenStreetMap sont utilisées, sans clé ni compte. Leur
# politique d'usage l'autorise sous conditions — attribution visible, Referer envoyé, cache
# respecté, aucun pré-chargement — et le code les tient.
# À renseigner seulement pour basculer vers un fournisseur (MapTiler, Stadia Maps).
MAP_TILES_URL=""
MAP_TILES_ATTRIBUTION=""

# Copier en .env.production **sur le VPS** et compléter. Ce fichier n'est jamais versionné,
# et aucune de ces valeurs ne doit apparaître dans le dépôt.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Adresse publique ------------------------------------------------------
# L'URL que le navigateur voit, terminée en HTTPS par le nginx de la machine. Elle sert de
# base aux liens magiques et aux liens d'invitation : une valeur fausse produit des liens
# qui ne mènent nulle part.
APP_PUBLIC_URL="https://onsort.eliott-b.fr"

# Port publié sur la boucle locale, vers lequel nginx relaie. À changer s'il est déjà pris.
HTTP_PORT=8080

# --- Base de données -------------------------------------------------------
# Générer avec : openssl rand -base64 24
# La base n'est pas exposée hors du réseau de la pile, mais un mot de passe par défaut
# resterait un mot de passe par défaut.
POSTGRES_PASSWORD=""

# --- Better Auth -----------------------------------------------------------
# Générer avec : openssl rand -base64 32
# Le changer invalide toutes les sessions ouvertes.
BETTER_AUTH_SECRET=""

# --- Courriel --------------------------------------------------------------
# Sans clé Resend, les liens magiques s'écrivent dans les journaux du conteneur et ne
# partent jamais : personne ne peut se connecter à distance.
RESEND_API_KEY=""
# Le domaine d'expédition doit être vérifié chez Resend, sinon les envois sont refusés.
MAIL_FROM="On Sort ? <onsort@proton.me>"
